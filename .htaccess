# Convite Premier · Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Descomente as duas linhas abaixo para forçar HTTPS (após ativar o SSL no hPanel)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Link exclusivo do convidado: /c/TOKEN
    RewriteRule ^c/([A-Za-z0-9]+)/?$ index.php?c=$1 [L,QSA]
</IfModule>

# Bloqueia arquivos que não devem ser públicos
<FilesMatch "\.(sqlite|sqlite3|db|log|md|sh|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
